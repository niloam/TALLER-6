        "    } else {\n",
        "        cociente = a / b;\n",
        "        residuo = a % b;\n",
        "    }\n",
        "}\n",
        "\n",
        "void sumaArreglo(int arr[], int n, int &resultado) {\n",
        "    resultado = 0;\n",
        "    for (int i = 0; i < n; i++) resultado += arr[i];\n",
        "}\n",
        "\n",
        "void sumaMatriz(int mat[][3], int filas, int columnas, int &resultado) {\n",
        "    resultado = 0;\n",
        "    for (int i = 0; i < filas; i++)\n",
        "        for (int j = 0; j < columnas; j++)\n",
        "            resultado += mat[i][j];\n",
        "}\n"
